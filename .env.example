# App
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/tracker

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue
TRACKER_QUEUE_NAME=tracker-queue
TRACKER_QUEUE_CONCURRENCY=10

# Data retention: auto-delete raw hits older than N days (0 = keep forever).
# Roll old data into summaries before enabling if you need long-term history.
TRACKER_TTL_DAYS=0
